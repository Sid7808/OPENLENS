# Server Configuration
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=openlens
POSTGRES_PASSWORD=openlens_secret
POSTGRES_DB=openlens_core
DATABASE_URL=postgresql+asyncpg://openlens:openlens_secret@localhost:5432/openlens_core

# JWT Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
